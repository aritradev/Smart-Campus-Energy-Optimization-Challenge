# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# LLM provider (PRIMARY: gemini — generative LLM mandated by competition rules)
#   deterministic   → fully offline, rule-based interpreter (safety net only;
#                       activated automatically if every Gemini model fails)
#   gemini          → Google Gemini SDK with multi-model fallback + 2s timeout
#   openai          → OpenAI-compatible HTTP API (set LLM_API_KEY + LLM_BASE_URL)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=20
LLM_TEMPERATURE=0

# Gemini (primary generative backend)
GEMINI_API_KEY=
# Comma-separated ordered fallback list. The first model is preferred; on
# timeout, HTTP error, or invalid JSON the orchestrator moves to the next.
# Ordered fastest / cheapest → most capable for the fallback chain.
GEMINI_MODEL_FALLBACK_LIST=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-pro-preview
# Strict per-model wall-clock cap (seconds). Default 3s for the
# Interactions API; lower if you have tighter SLAs.
LLM_REQUEST_TIMEOUT_SECONDS=3.0
# In-memory LRU cache size for duplicate note sequences (0 to disable).
GEMINI_CACHE_SIZE=256

# Set to 1 to disable auto-loading of .env (env vars come from process env only)
# GRIDWISE_SKIP_DOTENV=0

# LP solver
SOLVER_TIME_LIMIT=15
NUMERICAL_TOLERANCE_KWH=0.01
NUMERICAL_TOLERANCE_BDT=0.01
